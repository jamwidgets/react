{
  "name": "@jamwidgets/react",
  "version": "0.7.0",
  "description": "React hooks for Jamwidgets (forms, comments, reactions, subscriptions)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamwidgets/react.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://jamwidgets.com",
  "author": "Tim Marks <tim@imothee.xyz>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "jamwidgets",
    "forms",
    "comments",
    "reactions",
    "subscribe",
    "hooks"
  ],
  "license": "MIT",
  "dependencies": {
    "@jamwidgets/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "18.3.1",
    "react": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
